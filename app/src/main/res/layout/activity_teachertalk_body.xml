<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/Gray100">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/top_menu"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:background="@color/white">

                    <ImageView
                        android:id="@+id/back_btn"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_back_btn"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginTop="13dp"
                        android:layout_marginStart="20dp" />

                    <TextView
                        android:id="@+id/board_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="질문글"
                        android:textSize="18dp"
                        android:textColor="@color/Gray600"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginTop="12dp" />


                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/board"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_radius20_white"
                    app:layout_constraintTop_toBottomOf="@id/top_menu"
                    android:layout_marginTop="20dp"
                    android:layout_marginHorizontal="16dp"
                    android:paddingVertical="20dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_extra_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:id="@+id/btn_option"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_menu_24"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/body_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="18dp"
                            android:textColor="@color/Gray800"
                            android:textStyle="bold"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginEnd="64dp"/>

                        <ImageView
                            android:id="@+id/profile_image"
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:src="@drawable/profile_image"
                            app:layout_constraintTop_toBottomOf="@id/body_title"
                            app:layout_constraintStart_toStartOf="parent"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/user_nickname"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/Gray700"
                            android:gravity="center_vertical"
                            android:textSize="14dp"
                            android:layout_marginBottom="2dp"
                            app:layout_constraintTop_toTopOf="@id/profile_image"
                            app:layout_constraintBottom_toBottomOf="@id/profile_image"
                            app:layout_constraintStart_toEndOf="@id/profile_image"
                            android:layout_marginStart="4dp"/>

                        <TextView
                            android:id="@+id/date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2000.01.01"
                            android:textSize="9dp"
                            android:textColor="@color/Gray400"
                            app:layout_constraintTop_toTopOf="@id/user_nickname"
                            app:layout_constraintBottom_toBottomOf="@id/user_nickname"
                            app:layout_constraintStart_toEndOf="@id/user_nickname"
                            android:layout_marginStart="4dp" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/layout_question_guideline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toBottomOf="@id/date"
                            android:visibility="visible">

                            <TextView
                                android:id="@+id/first_field_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="작성자 유형"
                                android:background="@drawable/background_radius4_gray200"
                                android:textColor="@color/Purple500"
                                android:textAppearance="@style/TextAppearance.TeacherForBoss.Label6"
                                android:paddingVertical="6dp"
                                android:paddingHorizontal="6dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:layout_marginTop="20dp"/>

                            <TextView
                                android:id="@+id/first_field_content"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textAppearance="@style/TextAppearance.TeacherForBoss.Body3"
                                android:textColor="@color/Gray600"
                                app:layout_constraintStart_toStartOf="parent"
                                android:paddingStart="4dp"
                                app:layout_constraintTop_toBottomOf="@id/first_field_title"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/second_field_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="사업자등록 정보"
                                android:background="@drawable/background_radius4_gray200"
                                android:textColor="@color/Purple500"
                                android:textAppearance="@style/TextAppearance.TeacherForBoss.Label6"
                                android:paddingVertical="6dp"
                                android:paddingHorizontal="6dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/first_field_content"
                                android:layout_marginTop="12dp" />

                            <TextView
                                android:id="@+id/second_field_content"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textAppearance="@style/TextAppearance.TeacherForBoss.Body3"
                                android:textColor="@color/Gray600"
                                app:layout_constraintStart_toStartOf="parent"
                                android:paddingStart="4dp"
                                app:layout_constraintTop_toBottomOf="@id/second_field_title"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/third_field_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="사업장 정보"
                                android:background="@drawable/background_radius4_gray200"
                                android:textColor="@color/Purple500"
                                android:textAppearance="@style/TextAppearance.TeacherForBoss.Label6"
                                android:paddingVertical="6dp"
                                android:paddingHorizontal="6dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/second_field_content"
                                android:layout_marginTop="12dp" />

                            <TextView
                                android:id="@+id/third_field_content"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textAppearance="@style/TextAppearance.TeacherForBoss.Body3"
                                android:textColor="@color/Gray600"
                                app:layout_constraintStart_toStartOf="parent"
                                android:paddingStart="4dp"
                                app:layout_constraintTop_toBottomOf="@id/third_field_title"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/fourth_field_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="직원 관리"
                                android:background="@drawable/background_radius4_gray200"
                                android:textColor="@color/Purple500"
                                android:textAppearance="@style/TextAppearance.TeacherForBoss.Label6"
                                android:paddingVertical="6dp"
                                android:paddingHorizontal="6dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/third_field_content"
                                android:layout_marginTop="12dp" />

                            <TextView
                                android:id="@+id/fourth_field_content"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textAppearance="@style/TextAppearance.TeacherForBoss.Body3"
                                android:textColor="@color/Gray600"
                                app:layout_constraintStart_toStartOf="parent"
                                android:paddingStart="4dp"
                                app:layout_constraintTop_toBottomOf="@id/fourth_field_title"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/fifth_field_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="구입 증빙"
                                android:background="@drawable/background_radius4_gray200"
                                android:textColor="@color/Purple500"
                                android:textAppearance="@style/TextAppearance.TeacherForBoss.Label6"
                                android:paddingVertical="6dp"
                                android:paddingHorizontal="6dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/fourth_field_content"
                                android:layout_marginTop="12dp" />

                            <TextView
                                android:id="@+id/fifth_field_content"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textAppearance="@style/TextAppearance.TeacherForBoss.Body3"
                                android:textColor="@color/Gray600"
                                app:layout_constraintStart_toStartOf="parent"
                                android:paddingStart="4dp"
                                app:layout_constraintTop_toBottomOf="@id/fifth_field_title"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/sixth_field_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="매출 규모/사업자 구분"
                                android:background="@drawable/background_radius4_gray200"
                                android:textColor="@color/Purple500"
                                android:textAppearance="@style/TextAppearance.TeacherForBoss.Label6"
                                android:paddingVertical="6dp"
                                android:paddingHorizontal="6dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/fifth_field_content"
                                android:layout_marginTop="12dp" />

                            <TextView
                                android:id="@+id/sixth_field_content"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textAppearance="@style/TextAppearance.TeacherForBoss.Body3"
                                android:textColor="@color/Gray600"
                                app:layout_constraintStart_toStartOf="parent"
                                android:paddingStart="4dp"
                                app:layout_constraintTop_toBottomOf="@id/sixth_field_title"
                                android:layout_marginTop="4dp" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/writer_option"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/background_radius8_white_with_stroke"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/btn_option"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/modifyBtn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="수정하기"
                                android:textSize="11dp"
                                android:textColor="@color/Gray400"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:layout_marginTop="16dp"
                                android:layout_marginHorizontal="20dp" />

                            <TextView
                                android:id="@+id/deleteBtn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="삭제하기"
                                android:textSize="11dp"
                                android:textColor="@color/Gray400"
                                app:layout_constraintTop_toBottomOf="@id/modifyBtn"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="16dp" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/non_writer_option"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/background_radius8_white_with_stroke"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/btn_option"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/report_btn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="신고하기"
                                android:textSize="11dp"
                                android:textColor="@color/Gray400"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:layout_marginHorizontal="20dp"
                                android:layout_marginVertical="8dp" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:id="@+id/body_line"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        app:layout_constraintTop_toBottomOf="@id/layout_extra_content"
                        android:background="@color/Gray200"
                        android:visibility="visible"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/body_line"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/body_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/Gray600"
                            android:textAppearance="@style/TextAppearance.TeacherForBoss.Body3"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="8dp" />

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/vp_img_slider"
                            android:layout_width="match_parent"
                            android:layout_height="300dp"
                            app:layout_constraintTop_toBottomOf="@id/body_body"
                            android:layout_marginVertical="8dp"
                            android:visibility="gone" />

                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/tab_indicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:tabIndicatorHeight="0dp"
                            android:backgroundTint="@color/transparent"
                            app:layout_constraintBottom_toBottomOf="@id/vp_img_slider"
                            app:layout_constraintStart_toStartOf="@id/vp_img_slider"
                            app:layout_constraintEnd_toEndOf="@id/vp_img_slider"
                            app:tabPaddingStart="8dp"
                            app:tabPaddingEnd="8dp"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_tagArea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toBottomOf="@id/vp_img_slider"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal"/>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/like_and_bookmark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/background_radius8_gray100"
                            app:layout_constraintTop_toBottomOf="@id/rv_tagArea"
                            android:layout_marginTop="18dp">

                            <View
                                android:id="@+id/line"
                                android:layout_width="1dp"
                                android:layout_height="20dp"
                                android:background="@color/Gray300"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:layout_marginVertical="12dp"/>

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/like"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="@id/line"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent">

                                <ImageView
                                    android:id="@+id/like_iv"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:src="@drawable/community_like"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginVertical="6dp"/>

                                <TextView
                                    android:id="@+id/like_tv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="좋아요"
                                    android:textSize="14dp"
                                    android:textColor="@color/Gray400"
                                    app:layout_constraintStart_toEndOf="@id/like_iv"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginEnd="4dp"
                                    app:layout_constraintTop_toTopOf="parent"
                                    android:layout_marginTop="8dp" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/bookmark"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toStartOf="@id/line"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent">

                                <ImageView
                                    android:id="@+id/bookmark_iv"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:src="@drawable/community_bookmark"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginVertical="6dp" />

                                <TextView
                                    android:id="@+id/bookmark_tv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="저장하기"
                                    android:textSize="14dp"
                                    android:textColor="@color/Gray400"
                                    app:layout_constraintStart_toEndOf="@id/bookmark_iv"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginEnd="4dp"
                                    app:layout_constraintTop_toTopOf="parent"
                                    android:layout_marginTop="8dp" />

                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/answer_btn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/background_radius8_green100_with_stroke"
                            app:layout_constraintTop_toBottomOf="@id/like_and_bookmark"
                            android:layout_marginTop="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="답변 작성하기"
                                android:textColor="@color/green200"
                                android:textSize="14dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:layout_marginVertical="13dp" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/comment_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="답변 0개"
                    android:textAppearance="@style/TextAppearance.TeacherForBoss.Label3"
                    android:textColor="@color/Gray400"
                    app:layout_constraintTop_toBottomOf="@id/board"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_comment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintTop_toBottomOf="@id/comment_number"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    app:layout_constraintTop_toBottomOf="@id/rv_comment" />


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>